# Sample nginx config for the OVH dedicated server.
# Drop this in /etc/nginx/conf.d/oneshoplab.conf, then:
#   nginx -t && systemctl reload nginx
#
# TLS via certbot (will rewrite this file in-place to add the 443 block):
#   certbot --nginx -d oneshoplab.com -d www.oneshoplab.com

upstream oneshoplab_app {
    server 127.0.0.1:3030;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name oneshoplab.com www.oneshoplab.com;

    client_max_body_size 10m;
    proxy_read_timeout 60s;
    proxy_connect_timeout 10s;

    access_log /var/log/nginx/oneshoplab_access.log;
    error_log  /var/log/nginx/oneshoplab_error.log warn;

    # Security headers. If your nginx.conf already sets a global CSP, nginx
    # drops every inherited add_header as soon as we declare any here, so we
    # have to re-state HSTS / X-Frame-Options / etc. img-src is permissive on
    # https because merchant CDNs (Shopify, Wix, WooCommerce, custom) vary.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # script-src: Stripe (checkout), Google reCAPTCHA (audit/signup forms),
    # googletagmanager.com (consent-gated GA4 — beacons go to
    # google-analytics.com, already covered by connect-src/img-src https:).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; frame-src https://js.stripe.com https://hooks.stripe.com https://www.google.com/recaptcha/; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com" always;

    # Next.js (running on 127.0.0.1:3030) builds absolute URLs in middleware
    # redirects from its own listening address, so Location: headers leak
    # ":3030". Rewrite them to the public origin before they reach the client.
    proxy_redirect http://localhost:3030/    https://$host/;
    proxy_redirect https://localhost:3030/   https://$host/;
    proxy_redirect http://127.0.0.1:3030/    https://$host/;
    proxy_redirect https://127.0.0.1:3030/   https://$host/;
    proxy_redirect http://$host:3030/        https://$host/;
    proxy_redirect https://$host:3030/       https://$host/;

    # Static assets — long cache.
    location /_next/static/ {
        proxy_pass http://oneshoplab_app;
        proxy_cache_bypass $http_upgrade;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Stripe webhook — raw body, no buffering, real proto for sig verification.
    location /api/stripe/webhook {
        proxy_pass http://oneshoplab_app;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # kie.ai webhook — same treatment.
    location /api/kie/callback {
        proxy_pass http://oneshoplab_app;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location / {
        proxy_pass http://oneshoplab_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # X-Forwarded-Proto is intentionally omitted: Next.js's middleware
        # rewrite uses it to build the internal rewrite URL's protocol, and
        # with https here Next tries to TLS-handshake itself on :3030 → EPROTO.
        # Auth.js still emits Secure cookies because AUTH_URL=https://… is set.
        proxy_set_header X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
