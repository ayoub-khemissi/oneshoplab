# ROOT-ONLY. Real file → /etc/nginx/conf.d/00-r2-cdn-secrets.conf, chmod 600.
# This is a TEMPLATE committed for reference — never put the real token
# values in the repo. Fill the placeholders on the box only.
#
# http-context directives (conf.d is included inside http{}). Loaded
# before the server block via the 00- filename prefix.

# Load the SigV4 signing module (no secrets in it — safe path).
js_import r2sign from /etc/nginx/njs/r2-sign.js;

# Dedicated READ-ONLY R2 API token (Cloudflare → R2 → Manage API
# Tokens → Object Read only, scoped to bucket "oneshoplab").
js_var $r2_access_key_id   "REPLACE_WITH_READONLY_ACCESS_KEY_ID";
js_var $r2_secret_key      "REPLACE_WITH_READONLY_SECRET_ACCESS_KEY";

# S3 API endpoint host = <R2_ACCOUNT_ID>.r2.cloudflarestorage.com
js_var $r2_s3_host         "REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com";

# Bucket name (path-style S3 → /<bucket>/<key>).
js_var $r2_bucket          "oneshoplab";
