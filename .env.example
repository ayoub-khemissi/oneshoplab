# --- Database (MySQL 8) ---
# Local dev: create a user/db in MySQL.
# Production (OVH dedicated): create user + db, restrict to 127.0.0.1 or server IP.
DATABASE_URL=mysql://oneshoplab_dev:CHANGEME@localhost:3306/oneshoplab_dev

# --- Auth.js v5 ---
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=CHANGEME
AUTH_URL=http://localhost:3000

# --- kie.ai (text + image generation) ---
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai

# --- Cloudflare R2 (S3-compatible storage) ---
# Create a bucket on Cloudflare R2 and an S3 API token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oneshoplab-assets
R2_PUBLIC_URL=https://assets.example.com

# --- App ---
APP_URL=http://localhost:3000
APP_ENV=development

# Markup applied to kie's raw credit cost. 2.5x ≈ 70-78% gross margin at
# typical usage. Range [1, 10] (defaults to 2.5 outside this range).
CREDIT_MARKUP_FACTOR=2.5

# Comma-separated project IDs whose latest completed audit shows up on the
# public landing page as before/after social proof. Dedup'd by domain.
SHOWCASE_PROJECT_IDS=

# --- Stripe (subscriptions) ---
# Test mode: use sk_test_… and pk_test_… keys from https://dashboard.stripe.com/test/apikeys
# Production: use sk_live_… and pk_live_… keys (different env file)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret. Local dev: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints a `whsec_…` to paste here. Production: copy from the Stripe Dashboard → Webhooks → endpoint.
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — one per (plan, cycle).
# Create the products + recurring prices in your Stripe Dashboard:
#   - Starter Monthly  ($39.99 / month)
#   - Starter Yearly   ($383.90 / year — equivalent to $31.99/mo, -20% vs monthly)
#   - Pro Monthly      ($89.99 / month)
#   - Pro Yearly       ($863.90 / year — equivalent to $71.99/mo, -20%)
#   - Scale Monthly    ($199.99 / month)
#   - Scale Yearly     ($1919.90 / year — equivalent to $159.99/mo, -20%)
# Copy each price's `price_…` ID here. Leave empty until configured — the
# Subscribe button on /pricing will show "Coming soon" for unconfigured cycles.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_YEARLY=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Optional.
# Consent-gated: the <Analytics> component only injects gtag.js after the
# visitor accepts analytics in the cookie banner (IP anonymized, no ad
# signals). NEXT_PUBLIC_* is inlined at build time — rebuild after changing.
# Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — URL-prefix property verification. Paste ONLY
# the token from the "HTML tag" method (the content="..." value, not the
# whole meta tag). Renders <meta name="google-site-verification" …> in
# <head>. Read server-side per request — no rebuild needed. Leave empty
# if you verify via DNS TXT (Domain property) instead.
GSC_VERIFICATION=
