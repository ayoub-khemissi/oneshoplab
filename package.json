{
  "name": "oneshoplab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "worker:dev": "tsx watch src/worker/index.mts",
    "worker:start": "tsx src/worker/index.mts",
    "reconcile": "tsx scripts/reconcile-kie-jobs.ts",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings=0",
    "audit:prod": "pnpm audit --prod --audit-level critical",
    "i18n:check": "node scripts/check-i18n.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm i18n:check && pnpm deps:circular && pnpm test && pnpm audit:prod",
    "prepare": "husky",
    "deploy": "bash scripts/deploy.sh",
    "backup": "bash scripts/backup/backup-mysql.sh",
    "backup:restore-test": "bash scripts/backup/restore-test.sh",
    "backup:usage": "tsx scripts/backup/r2-backup.ts usage",
    "test": "vitest run",
    "test:unit": "VITEST_DB=0 vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:watch": "vitest",
    "deps:circular": "madge --extensions ts,tsx --ts-config tsconfig.json --circular src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.700.0",
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "bcryptjs": "^2.4.3",
    "client-zip": "^2.5.0",
    "drizzle-orm": "^0.45.2",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "mysql2": "^3.11.0",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.1.0",
    "tailwind-variants": "^0.3.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "madge": "^8.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-builder": ">=1.1.7"
    }
  }
}
